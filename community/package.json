{
  "name": "noctivago-community",
  "version": "0.1.0",
  "private": true,
  "description": "Community preset API for Noctívago (Cloudflare Worker + D1 + R2)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 execute noctivago-community --local --file=schema.sql",
    "db:remote": "wrangler d1 execute noctivago-community --remote --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
